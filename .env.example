# ==============================================================================
# NOBI INTERPRETER — POSTGRESQL & BACKEND CONFIGURATION
# Amazon Developer Hackathon 2026 — Alexa+ Track
# ==============================================================================

ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000", "http://127.0.0.1:8000"]

# ------------------------------------------------------------------------------
# PostgreSQL Database Credentials
# ------------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nobi_db

# Primary PostgreSQL Connection URL (Async Engine with psycopg2 / asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nobi_db

# Sync PostgreSQL URL (for scripts/migrations)
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/nobi_db

# Fallback SQLite DB (ensures instant out-of-the-box local operation if Postgres service is offline)
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./nobi_local.db

# ------------------------------------------------------------------------------
# Model Context Protocol (MCP) & Event Bus Settings
# ------------------------------------------------------------------------------
MCP_SERVER_NAME=Nobi-MCP-Interpreter
MCP_API_VERSION=1.0.0
SSE_HEARTBEAT_INTERVAL=15
ENABLE_SAFETY_GATE=true
DEFAULT_SAFETY_LEVEL=medium

